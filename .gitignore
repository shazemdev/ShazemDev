# Include your project-specific ignores in this file
# Read about how to use .gitignore: https://help.github.com/articles/ignoring-files
# Useful .gitignore templates: https://github.com/github/gitignore
node_modules
.cache

# Next.js build artefacts — out/ is what gets deployed
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo

# Wrangler's local state / cache
.wrangler/

# WebStorm settings and macOS cruft — must never be committed
.idea/
.DS_Store

# Personal Claude Code permissions (the shared config is .claude/settings.json)
.claude/settings.local.json

# The synced Tailwind docs snapshot. tailwindlabs/tailwindcss.com is
# source-available but NOT open-source, so the snapshot must stay local and
# must never be redistributed through this public repo. Re-create it with:
#   python3 .claude/skills/tailwind-4-docs/scripts/sync_tailwind_docs.py --accept-docs-license
*/skills/tailwind-4-docs/references/docs/
*/skills/tailwind-4-docs/references/docs-index.tsx
